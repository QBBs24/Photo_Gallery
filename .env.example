# Server Port & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL (Session Pooler - IPv4 Compatible)
# Replace [YOUR-DATABASE-PASSWORD] with your actual Supabase database password
DATABASE_URL="postgresql://postgres.ofwdbzkqrpwbkkruuxiz:[YOUR-DATABASE-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.ofwdbzkqrpwbkkruuxiz:[YOUR-DATABASE-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# SeaweedFS Object Storage (S3 API)
# Based on seaweedfs/config/s3.json credentials
SEAWEEDFS_S3_ENDPOINT=http://127.0.0.1:8333
SEAWEEDFS_ACCESS_KEY=gallery_access_key
SEAWEEDFS_SECRET_KEY=gallery_secret_key
SEAWEEDFS_BUCKET=photos
SEAWEEDFS_REGION=us-east-1
