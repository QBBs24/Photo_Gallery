{
  "name": "photo-gallery-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server start",
    "storage:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-seaweedfs.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
